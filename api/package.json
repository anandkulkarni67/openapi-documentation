{
  "name": "openapi-documentation-api",
  "version": "1.0.18",
  "private": true,
  "scripts": {
    "start": "ts-node src/index.ts",
    "gen-spec": "tsoa spec",
    "gen-routes": "tsoa routes",
    "build": "rimraf dist && npm run gen-spec && npm run gen-routes && tsc",
    "serve": "node dist/main.js",
    "tests": "mocha -require dotenv/config --require ts-node/register tests/**/*.test.ts --exit",
    "version": "echo $npm_package_version",
    "name": "echo $npm_package_name"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/sinon": "^21.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "mocha": "^11.7.5",
    "rimraf": "^6.1.3",
    "sinon": "^21.1.2",
    "ts-node": "^10.9.2",
    "tsoa": "^7.0.0-alpha.0",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1011.0",
